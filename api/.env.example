# Ứng dụng
ENVIRONMENT=development
DATA_DIR=../data
CORS_ORIGINS=http://localhost:3000

# Google Cloud
GCP_PROJECT=aiedu365
GCP_LOCATION=asia-southeast1
USE_FIRESTORE=false

# Nhà cung cấp mô hình mặc định khi chưa chọn trong trang quản trị.
# vertex | gemini | anthropic | openai | echo
LLM_PROVIDER=echo

# Khóa API — cách chính là nhập trong trang quản trị (lưu vào Secret Manager).
# Các biến dưới đây chỉ là phương án dự phòng cho môi trường phát triển.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Quản trị
ADMIN_EMAILS=hoanganh.goldenlight@gmail.com
FIREBASE_PROJECT_ID=aiedu365

# Lối vào quản trị cho phát triển cục bộ.
# Chỉ có tác dụng khi ENVIRONMENT=development. Để trống ở production.
DEV_ADMIN_TOKEN=
